# Copy to .env.local and fill in. Never commit .env.local.

# --- Voice (owned by voice-agent) ---
ELEVENLABS_API_KEY=sk_...
# Sarah. NOTE: Rachel (21m00Tcm4TlvDq8ikWAM) is a *library* voice and returns
# 402 on the free tier. Free-tier voices confirmed working: Sarah (below),
# Laura FGY2WhTYpPnrIDTdsKH5, Matilda XrExE9yKIg1WjnnlVkGX.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- Chat stub (delete once Member 2's route lands) ---
# If unset, /api/chat falls back to canned Dana Reyes lines so the
# voice loop is still demoable offline.
ANTHROPIC_API_KEY=sk-ant-...

# --- Memory (owned by Member 2) ---
MONGODB_URI=mongodb+srv://...
MONGODB_DB=rehearsal

# --- Backend (Express + MongoDB, backend/index.js) ---
# Local dev runs it on 3001. Deployed, it lives on Vercel (serverless, see
# backend/vercel.json) and this app's own deployment points BACKEND_URL at
# that host instead:
# https://backend-tau-five-41.vercel.app
BACKEND_URL=http://localhost:3001
