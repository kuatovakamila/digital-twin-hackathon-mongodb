# Copy to .env.local and fill in. Never commit .env.local.

# --- Voice (owned by voice-agent) ---
ELEVENLABS_API_KEY=sk_...
# Sarah. NOTE: Rachel (21m00Tcm4TlvDq8ikWAM) is a *library* voice and returns
# 402 on the free tier. Free-tier voices confirmed working: Sarah (below),
# Laura FGY2WhTYpPnrIDTdsKH5, Matilda XrExE9yKIg1WjnnlVkGX.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- Chat stub (delete once Member 2's route lands) ---
# If unset, /api/chat falls back to canned Dana Reyes lines so the
# voice loop is still demoable offline.
ANTHROPIC_API_KEY=sk-ant-...

# --- Memory ---
# The Next.js route layer talks to Atlas directly via lib/mongo.ts, so this is
# the only database variable that matters. The database name is fixed to
# "counterpart" in code to match backend/seed.js; MONGODB_DB is not read.
MONGODB_URI=mongodb+srv://...

# backend/index.js (Express) is no longer part of the running app — its
# endpoints now live in lib/backend.ts so the whole thing deploys to Vercel as
# one project. backend/seed.js is still how you seed the database.
